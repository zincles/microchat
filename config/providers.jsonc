{
  "version": 1,
  "providers": [
    // 开箱即用的 dummy：没有上游，模型只有一个 `dummy`。
    // 打到它的请求立刻得到一句「（测试用空模型）」——联调、测试用。
    // 注意：dummy 不需要 base_url，也不该填。
    { "id": "dummy", "kind": "dummy" },

    // 本地 Ollama（无需密钥）：
    // { "id": "ollama", "base_url": "http://127.0.0.1:11434/v1" },

    // OpenRouter（密钥写在 config/secrets.json：{ "openrouter": "sk-or-…" }）：
    // { "id": "openrouter", "base_url": "https://openrouter.ai/api/v1",
    //   "headers": { "X-Title": "microchat" } },

    // Command Code Studio（OpenAI 兼容）。密钥写在 config/secrets.json：
    // { "commandcode-direct": "…" }
    { "id": "commandcode-direct", "name": "Command Code",
      "base_url": "https://api.commandcode.ai/provider/v1" },

]
}
