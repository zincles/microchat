# ── 构建产物 ──────────────────────────────────────────────
/target
**/*.rs.bk

# ── 用户数据 ──────────────────────────────────────────────
# 会话与消息（SQLite）。战役存档是私人数据，不进版本库；
# 备份 = 抄 data/ 目录；导出/分享走应用自己的接口，不靠 git。
/data
*.db
*.db-wal
*.db-shm

# ── 密钥 ──────────────────────────────────────────────────
# providers.jsonc 里刻意不含密钥，密钥单独放这里（写入时 chmod 600）。
# 这一行是安全边界：其余 config/*.jsonc 都是可分享的模板。
/config/secrets.json

# ── 原子写的临时残留 ──────────────────────────────────────
# 配置写回用 tmp + rename；进程被强杀时可能留下 *.jsonc.tmp
*.tmp

# ── 日志与编辑器杂物 ──────────────────────────────────────
*.log
.vscode/
.idea/
.zed/
*.swp
*~
.DS_Store
Thumbs.db

# 注：Cargo.lock 要提交（这是应用而非库，锁死依赖版本）
# 注：config/config.jsonc、providers.jsonc、agents.jsonc 默认跟踪——它们是可分享的模板。
#     若想连个人配置也排除，加一行：/config/*.jsonc（代价是仓库里没了模板）
