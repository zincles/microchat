[gd_scene format=3]

[sub_resource type="StyleBoxFlat" id="StyleTable"]
content_margin_left = 10.0
content_margin_top = 8.0
content_margin_right = 10.0
content_margin_bottom = 8.0
bg_color = Color(1, 1, 1, 0.02)
border_width_top = 1
border_width_bottom = 1
border_color = Color(1, 1, 1, 0.06)

[node name="任务页" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="边距" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="列" type="VBoxContainer" parent="边距"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="标题" type="Label" parent="边距/列"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "任务"

[node name="说明" type="Label" parent="边距/列"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.62, 0.62, 1)
theme_override_font_sizes/font_size = 12
text = "进程内的事实（后端一重启就清零）—— 生成、压缩、刷新模型都在这儿挂号；流的细节（流到第几个字、取消）归那一刻的会话状态，不在这张表里。"

[node name="汇总行" type="HBoxContainer" parent="边距/列"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="在跑" type="Label" parent="边距/列/汇总行"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.47, 0.67, 0.47, 1)
theme_override_font_sizes/font_size = 14
text = "正在跑 1 个"

[node name="记录数" type="Label" parent="边距/列/汇总行"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.62, 0.62, 1)
theme_override_font_sizes/font_size = 12
text = "· 最近 3 条记录"

[node name="表头" type="PanelContainer" parent="边距/列"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleTable")

[node name="头" type="GridContainer" parent="边距/列/表头"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 18
theme_override_constants/v_separation = 4
columns = 5

[node name="状态" type="Label" parent="边距/列/表头/头"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.62, 0.62, 1)
theme_override_font_sizes/font_size = 12
text = "状态"

[node name="类型" type="Label" parent="边距/列/表头/头"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.62, 0.62, 1)
theme_override_font_sizes/font_size = 12
text = "类型"

[node name="在做什么" type="Label" parent="边距/列/表头/头"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.62, 0.62, 1)
theme_override_font_sizes/font_size = 12
text = "在做什么"

[node name="跑了" type="Label" parent="边距/列/表头/头"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.62, 0.62, 1)
theme_override_font_sizes/font_size = 12
text = "跑了"

[node name="结果" type="Label" parent="边距/列/表头/头"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.62, 0.62, 1)
theme_override_font_sizes/font_size = 12
text = "结果"

[node name="表格滚动" type="ScrollContainer" parent="边距/列"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="表格" type="GridContainer" parent="边距/列/表格滚动"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 18
theme_override_constants/v_separation = 4
columns = 5

[node name="状态1" type="Label" parent="边距/列/表格滚动/表格"]
layout_mode = 2
theme_override_colors/font_color = Color(0.47, 0.67, 0.47, 1)
theme_override_font_sizes/font_size = 13
text = "跑着"

[node name="类型1" type="Label" parent="边距/列/表格滚动/表格"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "生成"

[node name="事1" type="Label" parent="边距/列/表格滚动/表格"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "生成 · 会话 01a0e34b"

[node name="时1" type="Label" parent="边距/列/表格滚动/表格"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.62, 0.62, 1)
theme_override_font_sizes/font_size = 13
text = "1.2s"

[node name="果1" type="Label" parent="边距/列/表格滚动/表格"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.62, 0.62, 1)
theme_override_font_sizes/font_size = 13
text = "—"

[node name="状态2" type="Label" parent="边距/列/表格滚动/表格"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.62, 0.62, 1)
theme_override_font_sizes/font_size = 13
text = "结束"

[node name="类型2" type="Label" parent="边距/列/表格滚动/表格"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "压缩"

[node name="事2" type="Label" parent="边距/列/表格滚动/表格"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "压缩 2 块 · 会话 01a0e34b"

[node name="时2" type="Label" parent="边距/列/表格滚动/表格"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.62, 0.62, 1)
theme_override_font_sizes/font_size = 13
text = "240 ms"

[node name="果2" type="Label" parent="边距/列/表格滚动/表格"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.62, 0.62, 1)
theme_override_font_sizes/font_size = 13
text = "完成 · 2 块"

[node name="状态3" type="Label" parent="边距/列/表格滚动/表格"]
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.51, 0.51, 1)
theme_override_font_sizes/font_size = 13
text = "结束"

[node name="类型3" type="Label" parent="边距/列/表格滚动/表格"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "刷新模型"

[node name="事3" type="Label" parent="边距/列/表格滚动/表格"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "刷新模型 · commandcode-direct"

[node name="时3" type="Label" parent="边距/列/表格滚动/表格"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.62, 0.62, 1)
theme_override_font_sizes/font_size = 13
text = "1.8s"

[node name="果3" type="Label" parent="边距/列/表格滚动/表格"]
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.51, 0.51, 1)
theme_override_font_sizes/font_size = 13
text = "失败：上游 401"

[node name="空闲提示" type="Label" parent="边距/列"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.62, 0.62, 1)
theme_override_font_sizes/font_size = 12
text = "（一列跑完就照这个格式往里填；正在跑的在最前）"
