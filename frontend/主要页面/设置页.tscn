theme_override_colors/font_color = Color(0.62, 0.62, 0.62, 1)
theme_override_font_sizes/font_size = 12
text = "要让它活起来需要三件事：
1. 后端：crate::subagents::SubAgent 里加一个变体，写好它的内置模板与说明（名字/说明都在代码里）；
2. 接口：GET /subagents 会把它一并列出来（现在只返回摘要器那一条）；
3. 界面：照「摘要Agent」那一页把面板挪过来 —— 名字/说明/占位符表/模板/渠道模型/保存，
   并把这一页所有 unique_name_in_owner 的名字加上「索引_」前缀（整场景唯一，重复会互相顶掉）。"
autowrap_mode = 2
